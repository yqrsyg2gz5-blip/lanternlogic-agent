{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AgentShell Event Envelope v1",
  "type": "object",
  "required": [
    "id",
    "seq",
    "task_id",
    "type",
    "version",
    "ts",
    "payload"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^evt_\\d{6}$"
    },
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "task_id": {
      "type": "string",
      "pattern": "^task_\\d{8}_[a-z0-9]{4,32}$"
    },
    "type": {
      "type": "string",
      "enum": [
        "message",
        "message_delta",
        "action",
        "observation",
        "plan",
        "knowledge",
        "datasource",
        "status",
        "error"
      ]
    },
    "version": {
      "const": 1
    },
    "ts": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "oneOf": [
        {
          "$ref": "#/definitions/messagePayload"
        },
        {
          "$ref": "#/definitions/messageDeltaPayload"
        },
        {
          "$ref": "#/definitions/actionPayload"
        },
        {
          "$ref": "#/definitions/observationPayload"
        },
        {
          "$ref": "#/definitions/planPayload"
        },
        {
          "$ref": "#/definitions/knowledgePayload"
        },
        {
          "$ref": "#/definitions/datasourcePayload"
        },
        {
          "$ref": "#/definitions/statusPayload"
        },
        {
          "$ref": "#/definitions/errorPayload"
        }
      ]
    }
  },
  "definitions": {
    "messageDeltaPayload": {
      "type": "object",
      "required": [
        "delta"
      ],
      "properties": {
        "delta": {
          "type": "string"
        }
      }
    },
    "messagePayload": {
      "type": "object",
      "required": [
        "role",
        "text"
      ],
      "properties": {
        "role": {
          "enum": [
            "user",
            "assistant"
          ]
        },
        "text": {
          "type": "string"
        },
        "attachments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sources": {
          "type": "array",
          "description": "交付来源清单（add-only，2026-09-30）。仅含本次运行中确实访问过的链接。",
          "items": {
            "type": "object",
            "required": [
              "title",
              "url"
            ],
            "properties": {
              "title": {
                "type": "string"
              },
              "url": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "actionPayload": {
      "type": "object",
      "required": [
        "tool",
        "params",
        "call_id"
      ],
      "properties": {
        "tool": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "params": {
          "type": "object"
        },
        "call_id": {
          "type": "string"
        }
      }
    },
    "observationPayload": {
      "type": "object",
      "required": [
        "call_id",
        "ok",
        "result",
        "duration_ms"
      ],
      "properties": {
        "call_id": {
          "type": "string"
        },
        "ok": {
          "type": "boolean"
        },
        "result": {
          "type": "string"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "planPayload": {
      "type": "object",
      "required": [
        "steps",
        "current_step"
      ],
      "properties": {
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "no",
              "text",
              "status"
            ],
            "properties": {
              "no": {
                "type": "integer"
              },
              "text": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "pending",
                  "in_progress",
                  "done",
                  "failed"
                ]
              }
            }
          }
        },
        "current_step": {
          "type": "integer"
        },
        "reflection": {
          "type": "string"
        }
      }
    },
    "knowledgePayload": {
      "type": "object",
      "required": [
        "title",
        "content"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "content": {
          "type": "string"
        },
        "usage": {
          "type": "object",
          "description": "结构化用量（add-only，第41班/审计§7.2）。/usage 统计优先读这里，文本仅给人看。",
          "required": [
            "model",
            "calls",
            "input_tokens",
            "output_tokens"
          ],
          "properties": {
            "model": {
              "type": "string"
            },
            "calls": {
              "type": "integer",
              "minimum": 0
            },
            "input_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "output_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "cached_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "estimated": {
              "type": "boolean",
              "description": "上游未返回用量、按文本长度估算时为 true"
            }
          }
        }
      }
    },
    "datasourcePayload": {
      "type": "object",
      "required": [
        "name",
        "description"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "endpoint": {
          "type": "string"
        }
      }
    },
    "statusPayload": {
      "type": "object",
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "enum": [
            "running",
            "waiting_approval",
            "done",
            "failed",
            "partial",
            "idle",
            "cancelled"
          ]
        },
        "detail": {
          "type": "string"
        },
        "call_id": {
          "type": "string",
          "description": "add-only（P0-1）：state=waiting_approval 时携带，前端据此把审批按钮与对应 action 关联"
        }
      }
    },
    "errorPayload": {
      "type": "object",
      "required": [
        "message"
      ],
      "properties": {
        "message": {
          "type": "string"
        },
        "code": {
          "type": "string"
        }
      }
    }
  }
}
