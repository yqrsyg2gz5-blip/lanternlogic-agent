{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LanternLogic Agent",
  "version": "0.1.0",
  "identifier": "com.agentshell.desktop",
  "build": {
    "frontendDist": "../../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "LanternLogic Agent",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/agent-shell.ico"
    ],
    "resources": [
      "bin/agent-shell-backend.exe",
      "bin/config.json",
      "bin/skills/**/*"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese"
        ]
      }
    }
  }
}
